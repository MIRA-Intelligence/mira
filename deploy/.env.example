# Optional tags (for self-hosted profile in ../docker-compose.yml)
MIRA_AGENT_TAG=latest
MIRA_UI_TAG=latest

# Published host ports (bound to the host's loopback only; see docs/remote-access.md)
MIRA_AGENT_PORT=18790
MIRA_UI_PORT=8080

# UI -> agent routing
MIRA_API_URL=http://localhost:18790/api
MIRA_WS_URL=ws://localhost:18790/ws
