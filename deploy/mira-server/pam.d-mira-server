# /etc/pam.d/mira-server - PAM service used by Mira Server to check passwords.
#
# Debian/Ubuntu: reuse the system stacks, so local accounts, LDAP/SSSD,
# password policy, expiry and lockouts apply as they do for SSH.
@include common-auth
@include common-account

# RHEL/Fedora equivalent:
#   auth     include  password-auth
#   account  include  password-auth
#
# pam_unix (local /etc/shadow passwords): a non-root process can only verify
# OTHER users' passwords if it can read /etc/shadow. On Debian/Ubuntu add the
# mira-server account to the "shadow" group (see docs/server-edition/mira-server.md).
# pam_sss (SSSD/LDAP) needs no extra privileges.
